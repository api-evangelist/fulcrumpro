{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fulcrum Public Accounting Code Invoice Line Item API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Invoice Line Item",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a specific line item for an invoice of generic type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fulcrumpro.com/api/invoices/:invoiceId/line-items/:lineItemId",
            "params": [
              {
                "name": "invoiceId",
                "value": "",
                "type": "path"
              },
              {
                "name": "lineItemId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific line item for an invoice of generic type"
        },
        {
          "info": {
            "name": "Get a list of lines items for an invoice, regardless of type",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fulcrumpro.com/api/invoices/:invoiceId/line-items/list",
            "params": [
              {
                "name": "invoiceId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a list of lines items for an invoice, regardless of type"
        }
      ]
    }
  ],
  "bundled": true
