        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a specific line item for a purchase order of generic type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fulcrumpro.com/api/purchase-orders/:purchaseOrderId/line-items/:lineItemId",
            "params": [
              {
                "name": "purchaseOrderId",
                "value": "",
                "type": "path"
              },
              {
                "name": "lineItemId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific line item for a purchase order of generic type"
        },
        {
          "info": {
            "name": "Get a list of lines items for a purchase order, regardless of type",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fulcrumpro.com/api/purchase-orders/:purchaseOrderId/line-items/list",
            "params": [
              {
                "name": "purchaseOrderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a list of lines items for a purchase order, regardless of type"
        },
        {
          "info": {
            "name": "Get tax allocations for a specific line item on a purchase order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fulcrumpro.com/api/purchase-orders/:purchaseOrderId/line-items/:lineItemId/tax-allocations",
            "params": [
              {
                "name": "purchaseOrderId",
                "value": "",
                "type": "path"
              },
              {
                "name": "lineItemId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get tax allocations for a specific line item on a purchase order"
        }
      ]
    }
  ],
  "bundled": true
