      "info": {
        "name": "Timer",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Creates a completed timer block retroactively. Unlike the start/stop endpoints, which stamp the server\ntime on receipt, this endpoint accepts explicit timestamps so integrations can submit a whole block of\ntime after the fact. Blocks may not be in the future, older than 30 days, or longer than 7 days.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fulcrumpro.com/api/timers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a completed timer block retroactively. Unlike the start/stop endpoints, which stamp the server\ntime on receipt, this endpoint accepts explicit timestamps so integrations can submit a whole block of\ntime after the fact. Blocks may not be in the future, older than 30 days, or longer than 7 days."
        },
